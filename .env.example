# LYRIA Configuration Template
# Copy this file to .env and fill in your values

# ============================================================================
# API Configuration (Required)
# ============================================================================
# DashScope API key for Qwen models
# Get from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-oa/v1

# ============================================================================
# Model Configuration (Can be customized)
# ============================================================================
# Analysis model - sends video to this Qwen model for narration
ANALYSIS_MODEL=qwen-max-latest

# TTS model - generates speech from text
TTS_MODEL=qwen3-tts-flash

# Caption/transcription model
CAPTION_MODEL=faster-whisper

# ============================================================================
# Video Input (Required)
# ============================================================================
# downloadwella.com URLs
# Examples:
#   https://downloadwella.com/hg8nwy6xu862/Azure.Spring.S01E01.(THENKIRI.COM).mkv.html
#   https://downloadwella.com/[file_id]/[file_name].html
VIDEO_SOURCE_URL=https://downloadwella.com/YOUR_FILE_ID/YOUR_FILE_NAME.html

# ============================================================================
# Voice Configuration (Customizable)
# ============================================================================
# Voice selection - determines which voice generates narration
# Options: sweet_tea_male, (more coming soon)
VOICE_ID=sweet_tea_male

# Voice style/emotion - affects tone of delivery
# For sweet_tea_male: american_drama_tension, conversational, news
VOICE_STYLE=american_drama_tension

# TTS output language (always English for narration)
LANGUAGE=en-US

# Narration language (ensures English-only output)
NARRATION_LANGUAGE=English

# ============================================================================
# Output Configuration (Optional)
# ============================================================================
# Where to save generated videos, audio, captions, etc.
OUTPUT_DIR=./outputs

# Store outputs locally (true) or prepare for cloud upload (false)
LOCAL_DELIVERY=true

# ============================================================================
# Processing Configuration (Optional)
# ============================================================================
# GPU acceleration - set to true only if CUDA/GPU available
USE_GPU=false

# Number of CPU threads to use (1-8 recommended)
CPU_THREADS=4

# Batch processing size (lower = less memory, slower)
BATCH_SIZE=4

# ============================================================================
# Color Grading & Presets (Optional)
# ============================================================================
# LUT (Look-Up Table) file for color grading
# Included preset: ./07_Davinci Resolve LUTs_Sunset.cube
LUT_FILE=./07_Davinci Resolve LUTs_Sunset.cube

# ============================================================================
# Advanced Options (Optional)
# ============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Maximum video duration to process (minutes)
# Set to 10 to match the plan's 10-minute window
MAX_VIDEO_DURATION=10

# Upscaling factor (2x, 4x) - only applies if using GPU
UPSCALE_FACTOR=2

# ============================================================================
# Notes
# ============================================================================
# - All commented options show defaults
# - API_KEY is required, everything else has sensible defaults
# - To run: python main.py
# - To run specific phases: python main.py --phases 1,2,3
# - Check QUICKSTART.md for quick reference
# - Check README.md for detailed documentation
